{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GokTurkReasoningSteps",
  "description": "The sole JSON object emitted by each teacher for one question.",
  "type": "object",
  "additionalProperties": false,
  "required": ["understand", "plan", "solve", "verify", "answer", "confidence"],
  "properties": {
    "understand": {"type": "string", "minLength": 1, "maxLength": 600},
    "plan": {"type": "string", "minLength": 1, "maxLength": 800},
    "solve": {"type": "string", "minLength": 1, "maxLength": 1600},
    "verify": {"type": "string", "minLength": 1, "maxLength": 800},
    "answer": {"type": "string", "minLength": 1, "maxLength": 1200},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
