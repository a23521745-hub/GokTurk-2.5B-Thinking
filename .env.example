# Copy to .env, then run: chmod 600 .env
# Never commit .env, paste keys into logs, or send sensitive/classified prompts to external teachers.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Use the exact region/workspace URL shown in Alibaba Cloud Model Studio.
# The URL normally ends in /compatible-mode/v1; API keys are region-specific.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-max

# Optional EVREN-hosted teachers; copy base URL and exact model ids from your authenticated portal.
EVREN_LLM_API_KEY=
EVREN_BASE_URL=
EVREN_DEEPSEEK_MODEL=
EVREN_QWEN_MODEL=

# Replace with the real, licensed student base model if different from the repository's 3B example.
STUDENT_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct

# Pin llama.cpp to a reviewed release tag or commit SHA for a reproducible GGUF build.
LLAMA_CPP_DIR=
LLAMA_CPP_REF=
